{
  "name": "@data-vault/mobile",
  "version": "0.1.0",
  "description": "DataVault native mobile client built with Lynx and Sparkling",
  "type": "module",
  "dependencies": {
    "@lynx-js/react": "^0.116.2",
    "@tanstack/react-query": "^5.90.21",
    "sparkling-navigation": "^2.0.1"
  },
  "devDependencies": {
    "@lynx-js/qrcode-rsbuild-plugin": "^0.4.4",
    "@lynx-js/react-rsbuild-plugin": "^0.12.7",
    "@lynx-js/rspeedy": "^0.13.3",
    "@lynx-js/types": "^3.6.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/react": "^18.3.20",
    "@vitest/coverage-v8": "^4.0.18",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "sparkling-app-cli": "~2.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": "^22 || ^24"
  },
  "private": true,
  "scripts": {
    "build": "sparkling-app-cli build --skip-copy",
    "dev": "sparkling-app-cli build --skip-copy && rspeedy dev --config .sparkling/lynx.config.ts",
    "build:copy": "sparkling-app-cli build --copy",
    "autolink": "sparkling-app-cli autolink",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "run:android": "sparkling-app-cli run:android",
    "run:ios": "sparkling-app-cli run:ios --copy"
  }
}
