# Copy to deploy/.env.production. Never commit the real file.
DOMAIN=vault.example.org
POSTGRES_ADMIN_PASSWORD=
DATABASE_APP_PASSWORD=

API_URL=https://vault.example.org
WEB_URL=https://vault.example.org
ALLOWED_ORIGINS=https://vault.example.org
EXTENSION_REDIRECT_URL=https://<extension-id>.chromiumapp.org/data-vault-auth

# openssl rand -base64 48   (two different values)
SESSION_SECRET=
JWT_SECRET=
# openssl rand -base64 32
AI_KEY_ENCRYPTION_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DataVault <no-reply@vault.example.org>

TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
GEMINI_API_KEY=
