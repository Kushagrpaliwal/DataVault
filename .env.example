# Runtime
#
# PRODUCTION: set NODE_ENV=production. The API then refuses to start while any
# secret is a placeholder, API_URL / WEB_URL / ALLOWED_ORIGINS are not https
# addresses, SMTP_HOST is empty, or AI_ALLOW_PRIVATE_ENDPOINTS is true.
# VITE_API_URL and VITE_WEB_URL must be your real https addresses when you
# build the web app and the extension (a build against localhost fails unless
# ALLOW_LOCAL_BUILD=true). See docs/deployment.md.
NODE_ENV=development
API_PORT=3000
API_URL=http://localhost:3000
WEB_URL=http://localhost:5173
VITE_PORT=5173
WXT_PORT=3002
VITE_API_URL=http://localhost:3000
VITE_WEB_URL=http://localhost:5173

# PostgreSQL. The application connects as a role of its own, so the
# row-level security rules on the tables apply to it. The migrations run as
# the administrative role. Run `bun run db:create-role` once after changing
# these, to give the application role its grants.
DATABASE_URL=postgresql://data_vault_app:change-me@localhost:5432/data_vault
DATABASE_ADMIN_URL=postgresql://postgres:change-me@localhost:5432/data_vault
TEST_DATABASE_URL=postgresql://data_vault_app:change-me@localhost:5432/data_vault_test

# Authentication: generate independent random values of at least 32 bytes.
SESSION_SECRET=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-different-long-random-secret
ALLOWED_ORIGINS=http://localhost:5173
EXTENSION_REDIRECT_URL=https://replace-with-extension-id.chromiumapp.org/data-vault-auth

# How many reverse proxies sit in front of the API. X-Forwarded-For is only
# believed when this is greater than zero, otherwise a client can spoof its
# own address and walk past the rate limits. Leave at 0 without a proxy.
TRUSTED_PROXY_HOPS=0

# Cloudflare Turnstile guards sign-up. The signup captcha stays inert while
# both values are blank, so development is not blocked by it.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
# Pool size of the API database connection (default 10).
DATABASE_POOL_SIZE=10

# SMTP is required in production. Development logs reset links if these are blank.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DataVault <no-reply@example.com>

MAX_ATTACHMENT_BYTES=5242880

# Gemini powers the AI features. The AI features stay inert while the key is
# blank, so nothing breaks until you add one.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# The model that turns text into numbers for the search by meaning. The old
# one (text-embedding-004) was switched off by Google on 2026-01-14.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# The Gemini free tier allows a fixed number of requests per day for the whole
# project, shared by every user. Set AI_GLOBAL_DAILY_REQUESTS to the number
# shown in AI Studio, minus a little headroom, so the server throttles itself
# before Google does.
AI_GLOBAL_DAILY_REQUESTS=900
# The budget for making the numbers of saved items. These are cheaper than a
# written answer, but they are shared too, so they have a budget of their own.
AI_GLOBAL_DAILY_EMBEDDINGS=900
AI_GLOBAL_MINUTE_REQUESTS=12
AI_USER_DAILY_CREDITS=20
AI_USER_MINUTE_REQUESTS=5
AI_MAX_INPUT_TOKENS=4000
AI_MAX_OUTPUT_TOKENS=8192

# Bring your own key.
#
# The key that encrypts the keys people bring themselves: 32 bytes, written
# as base64. Without it nobody can connect a provider of their own, and the
# free credits are the only way to use the AI. It is not a secret of the
# users', so it may be kept in the same place as the other secrets.
#   openssl rand -base64 32
AI_KEY_ENCRYPTION_KEY=
# Whether the server may call a model on the local network. Ollama and LM
# Studio are usually on the same network as the browser, so a person who
# runs a model on their own machine needs this. It is off by default,
# because an address on the local network can reach things that are not
# meant to be reached.
AI_ALLOW_PRIVATE_ENDPOINTS=false
# The caps for a request that is paid for by the person. Their own key has
# no free tier to run out of, so the caps are larger than the shared ones.
AI_BYO_MAX_INPUT_TOKENS=32000
AI_BYO_MAX_OUTPUT_TOKENS=8192

# The free tier may use submitted content to improve Google's products, so
# users are asked to agree before anything is sent. Keep this on.
AI_FREE_TIER_CONTENT_NOTICE=true
