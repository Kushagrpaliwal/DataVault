{
  "name": "data-vault",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --env-file=.env scripts/dev.ts",
    "dev:web": "bun --env-file=.env run --filter @data-vault/web dev",
    "dev:api": "bun --env-file=.env run --filter @data-vault/api dev",
    "dev:extension": "bun --env-file=.env run --filter @data-vault/extension dev",
    "build": "bun --env-file=.env run --filter './apps/*' --parallel build",
    "build:web": "bun --env-file=.env run --filter @data-vault/web build",
    "build:api": "bun --env-file=.env run --filter @data-vault/api build",
    "build:extension": "bun --env-file=.env run --filter @data-vault/extension build",
    "build:extension:firefox": "bun --env-file=.env run --filter @data-vault/extension build:firefox",
    "test": "bun --env-file=.env test apps packages",
    "test:e2e": "bun run scripts/smoke-web.ts",
    "smoke:web": "bun run scripts/smoke-web.ts",
    "make-smoke-account": "bun --env-file=.env scripts/make-smoke-account.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit && bun --env-file=.env run --filter '*' --parallel typecheck",
    "db:generate": "bun --env-file=.env run --filter @data-vault/database db:generate",
    "db:migrate": "bun --env-file=.env run --filter @data-vault/database db:migrate",
    "db:bootstrap": "bun --env-file=.env run --filter @data-vault/database db:bootstrap",
    "db:create-role": "bun --env-file=.env run --filter @data-vault/database db:create-role",
    "db:migrate-test": "bun --env-file=.env run --filter @data-vault/database db:migrate-test",
    "db:check": "bun --env-file=.env run --filter @data-vault/database db:check",
    "db:inspect-rls": "bun --env-file=.env run --filter @data-vault/database db:inspect-rls",
    "db:recreate-test": "bun --env-file=.env run --filter @data-vault/database db:recreate-test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.3.10",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "overrides": {
    "@tiptap/html>happy-dom": "^21.0.4",
    "happy-dom": "^21.0.4",
    "shell-quote": "^1.8.5",
    "tmp": "^0.2.6",
    "source-map-js": "^1.2.2",
    "adm-zip": "^0.6.1",
    "node-forge": "^1.4.3",
    "uuid": "^11.1.1",
    "vite": "^8.3.6",
    "zod": "^4.6.7"
  }
}
